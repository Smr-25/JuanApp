@model JuanApp.BLL.Dtos.OrderDto

@{
    ViewData["Title"] = "Order Details";
}

<div class="page-header">
    <h1 class="page-title">Order Details - #@Model.OrderNumber</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Order">Orders</a></li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-box-seam me-2"></i>Order Items</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Color/Size</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td><strong>@item.ProductName</strong></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.SelectedColor))
                                        {
                                            <span class="badge bg-secondary">@item.SelectedColor</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.SelectedSize))
                                        {
                                            <span class="badge bg-secondary">@item.SelectedSize</span>
                                        }
                                    </td>
                                    <td>₼@item.Price.ToString("F2")</td>
                                    <td>@item.Quantity</td>
                                    <td><strong>₼@item.TotalPrice.ToString("F2")</strong></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end"><strong>Total:</strong></td>
                                <td><strong class="text-primary">₼@Model.TotalPrice.ToString("F2")</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-person me-2"></i>Customer Info</h5>
            </div>
            <div class="card-body">
                <p><strong>Name:</strong> @Model.UserFullName</p>
                <p><strong>Email:</strong> @Model.UserEmail</p>
                <p><strong>Phone:</strong> @Model.ContactPhone</p>
                <p><strong>Address:</strong><br>@Model.ShippingAddress</p>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header">
                <h5><i class="bi bi-info-circle me-2"></i>Order Info</h5>
            </div>
            <div class="card-body">
                <p><strong>Order Number:</strong> #@Model.OrderNumber</p>
                <p><strong>Date:</strong> @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                <p><strong>Status:</strong> 
                    @if (Model.Status == "Completed")
                    {
                        <span class="badge bg-success">@Model.Status</span>
                    }
                    else if (Model.Status == "Processing")
                    {
                        <span class="badge bg-warning">@Model.Status</span>
                    }
                    else if (Model.Status == "Pending")
                    {
                        <span class="badge bg-info">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@Model.Status</span>
                    }
                </p>
                
                <form asp-action="UpdateStatus" method="post" class="mt-3">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label class="form-label"><strong>Update Status:</strong></label>
                    <select name="status" class="form-select mb-2">
                        <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                        <option value="Processing" selected="@(Model.Status == "Processing")">Processing</option>
                        <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                    </select>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-check-lg me-2"></i>Update Status
                    </button>
                </form>
            </div>
        </div>
        
        <a href="/Admin/Order" class="btn btn-secondary w-100 mt-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Orders
        </a>
    </div>
</div>

