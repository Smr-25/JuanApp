@model List<JuanApp.BLL.Dtos.ProductSizeDto>
@{ViewData["Title"] = "Sizes";}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-ruler me-2"></i>Sizes</h5>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Add Size</a>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead><tr><th>ID</th><th>Name</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var size in Model)
                {
                    <tr>
                        <td>@size.Id</td>
                        <td><strong>@size.Name</strong></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@size.Id" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@size.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

