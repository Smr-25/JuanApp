@model JuanApp.BLL.Dtos.ProductSizeDto

@{
    ViewData["Title"] = "Edit Size";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Size</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div class="mb-3">
                <label for="name" class="form-label">Size Name</label>
                <input type="text" name="name" id="name" class="form-control" value="@Model.Name" required />
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Update</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times me-2"></i>Cancel</a>
        </form>
    </div>
</div>

