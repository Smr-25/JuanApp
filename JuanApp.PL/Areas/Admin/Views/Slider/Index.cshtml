@model List<JuanApp.BLL.Dtos.HomeSliderDto>

@{
    ViewData["Title"] = "Sliders";
}

<div class="page-header">
    <h1 class="page-title">Sliders</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
            <li class="breadcrumb-item active">Sliders</li>
        </ol>
    </nav>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-images me-2"></i>Slider List (@(Model?.Count ?? 0))</h5>
        <a href="/Admin/Slider/Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>New Slider
        </a>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Subtitle</th>
                            <th>Button</th>
                            <th>Main</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slider in Model)
                        {
                            <tr>
                                <td><strong>#@slider.Id</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(slider.ImageUrl))
                                    {
                                        <img src="/@slider.ImageUrl" alt="@slider.Title" style="width: 100px; height: 50px; object-fit: cover; border-radius: 0.5rem;">
                                    }
                                    else
                                    {
                                        <div style="width: 100px; height: 50px; background: #e2e8f0; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td><strong>@slider.Title</strong></td>
                                <td>@slider.SubTitle</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(slider.ButtonText))
                                    {
                                        <span class="badge bg-info">@slider.ButtonText</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (slider.IsMain)
                                    {
                                        <span class="badge bg-success">Main</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="/Admin/Slider/Edit/@slider.Id" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form action="/Admin/Slider/Delete/@slider.Id" method="post" class="d-inline" 
                                              data-confirm="Are you sure you want to delete this slider?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-images empty-state-icon"></i>
                <h3 class="empty-state-title">No sliders yet</h3>
                <p class="empty-state-description">Add your first slider</p>
                <a href="/Admin/Slider/Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-2"></i>Add Slider
                </a>
            </div>
        }
    </div>
</div>

