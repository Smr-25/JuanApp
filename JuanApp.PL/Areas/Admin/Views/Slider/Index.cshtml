@model List<JuanApp.BLL.Dtos.HomeSliderDto>

@{
    ViewData["Title"] = "Sliders";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-images me-2"></i>Sliders</h5>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Add Slider
        </a>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Subtitle</th>
                    <th>Main</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slider in Model)
                {
                    <tr>
                        <td>@slider.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(slider.ImageUrl))
                            {
                                <img src="@slider.ImageUrl" alt="@slider.Title" style="width: 80px; height: 50px; object-fit: cover; border-radius: 5px;">
                            }
                        </td>
                        <td><strong>@slider.Title</strong></td>
                        <td>@slider.SubTitle</td>
                        <td>
                            @if (slider.IsMain)
                            {
                                <span class="badge bg-primary">Main</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Regular</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@slider.Id" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@slider.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Are you sure?');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

