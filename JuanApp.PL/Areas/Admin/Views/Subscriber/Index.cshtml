@model List<JuanApp.BLL.Dtos.SubscriberDto>

@{
    ViewData["Title"] = "Subscribers Management";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-envelope me-2"></i>Email Subscribers</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            These users will receive email notifications when new products are added.
        </div>
        
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Subscribed Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subscriber in Model)
                    {
                        <tr>
                            <td>@subscriber.Id</td>
                            <td><i class="fas fa-envelope me-2"></i>@subscriber.Email</td>
                            <td>
                                @if (subscriber.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@subscriber.SubscribedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (subscriber.IsActive)
                                {
                                    <form asp-action="Unsubscribe" asp-route-id="@subscriber.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to unsubscribe this user?');">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-ban"></i> Unsubscribe
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

