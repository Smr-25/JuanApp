<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Juan Admin Panel</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <!-- Admin Custom CSS -->
    <link rel="stylesheet" href="~/assets/admin/css/admin.css">
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-shopping-bag" style="font-size: 2rem; color: var(--primary-color);"></i>
            <h3>Juan Admin</h3>
        </div>
        
        <ul class="sidebar-menu">
            <li class="menu-item">
                <a href="/Admin/Dashboard" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2 menu-icon"></i>
                    <span class="menu-text">Dashboard</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Product" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")">
                    <i class="bi bi-box-seam menu-icon"></i>
                    <span class="menu-text">Products</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Category" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                    <i class="bi bi-grid menu-icon"></i>
                    <span class="menu-text">Categories</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Color" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Color" ? "active" : "")">
                    <i class="bi bi-palette menu-icon"></i>
                    <span class="menu-text">Colors</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Size" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Size" ? "active" : "")">
                    <i class="bi bi-rulers menu-icon"></i>
                    <span class="menu-text">Sizes</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Order" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")">
                    <i class="bi bi-cart-check menu-icon"></i>
                    <span class="menu-text">Orders</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Slider" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Slider" ? "active" : "")">
                    <i class="bi bi-images menu-icon"></i>
                    <span class="menu-text">Sliders</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Advantage" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Advantage" ? "active" : "")">
                    <i class="bi bi-award menu-icon"></i>
                    <span class="menu-text">Advantages</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Subscriber" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subscriber" ? "active" : "")">
                    <i class="bi bi-envelope menu-icon"></i>
                    <span class="menu-text">Subscribers</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Blog" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Blog" ? "active" : "")">
                    <i class="bi bi-newspaper menu-icon"></i>
                    <span class="menu-text">Blogs</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Settings" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="bi bi-gear menu-icon"></i>
                    <span class="menu-text">Settings</span>
                </a>
            </li>
            
            <li class="menu-item" style="margin-top: 2rem;">
                <a href="/" class="menu-link" target="_blank">
                    <i class="bi bi-globe menu-icon"></i>
                    <span class="menu-text">View Site</span>
                </a>
            </li>
            
            <li class="menu-item">
                <a href="/Admin/Auth/Logout" class="menu-link">
                    <i class="bi bi-box-arrow-right menu-icon"></i>
                    <span class="menu-text">Logout</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- Navbar -->
    <nav class="navbar-custom">
        <div class="navbar-left">
            <button class="toggle-btn" id="toggleSidebar">
                <i class="bi bi-list"></i>
            </button>
            
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Axtar..." class="form-control">
            </div>
        </div>
        
        <div class="navbar-right">

            <div class="dropdown">
                <div class="user-dropdown" data-bs-toggle="dropdown">
                    <div class="user-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div class="user-info">
                        <span class="user-name">@(User.Identity?.Name ?? "Admin")</span>
                        <span class="user-role">@(User.IsInRole("SuperAdmin") ? "Super Admin" : User.IsInRole("Admin") ? "Admin" : "Moderator")</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Profil</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Tənzimləmələr</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/Admin/Auth/Logout"><i class="bi bi-box-arrow-right me-2"></i>Çıxış</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <!-- Admin Custom JS -->
    <script src="~/assets/admin/js/admin.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

