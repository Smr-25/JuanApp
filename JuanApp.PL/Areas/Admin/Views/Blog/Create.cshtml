@model JuanApp.Core.Models.Blog

@{
    ViewData["Title"] = "Create Blog";
}

<div class="page-header">
    <h1 class="page-title">Create New Blog</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Blog">Blogs</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-pencil me-2"></i>Blog Content</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Short Description <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Content" class="form-label">Full Content <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" class="form-control" rows="10" required></textarea>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-info-circle me-2"></i>Blog Info</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Author" class="form-label">Author</label>
                        <input asp-for="Author" class="form-control" value="Admin" />
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label">Category</label>
                        <input asp-for="Category" class="form-control" placeholder="Fashion, Lifestyle, etc." />
                    </div>
                    
                    <div class="mb-3">
                        <label for="imageFile" class="form-label">Blog Image <span class="text-danger">*</span></label>
                        <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*" required />
                        <small class="text-muted">Recommended: 1200x600px</small>
                    </div>
                </div>
            </div>
            
            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <a href="/Admin/Blog" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Back
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-2"></i>Publish
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

