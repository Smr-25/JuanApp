@model Dictionary<string, string>

@{
    ViewData["Title"] = "Settings";
}

<div class="page-header">
    <h1 class="page-title">Site Settings</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
            <li class="breadcrumb-item active">Settings</li>
        </ol>
    </nav>
</div>

<form asp-area="Admin" asp-action="Update" method="post">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-building me-2"></i>Company Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Company Name</label>
                        <input type="text" name="CompanyName" value="@(Model.ContainsKey("CompanyName") ? Model["CompanyName"] : "")" class="form-control" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea name="Address" class="form-control" rows="2">@(Model.ContainsKey("Address") ? Model["Address"] : "")</textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Contact Phone</label>
                        <input type="text" name="ContactPhone" value="@(Model.ContainsKey("ContactPhone") ? Model["ContactPhone"] : "")" class="form-control" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Contact Email</label>
                        <input type="email" name="ContactEmail" value="@(Model.ContainsKey("ContactEmail") ? Model["ContactEmail"] : "")" class="form-control" />
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-share me-2"></i>Social Media</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label"><i class="fa fa-facebook me-2"></i>Facebook URL</label>
                        <input type="url" name="FacebookUrl" value="@(Model.ContainsKey("FacebookUrl") ? Model["FacebookUrl"] : "")" class="form-control" placeholder="https://facebook.com/yourpage" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label"><i class="fa fa-twitter me-2"></i>Twitter URL</label>
                        <input type="url" name="TwitterUrl" value="@(Model.ContainsKey("TwitterUrl") ? Model["TwitterUrl"] : "")" class="form-control" placeholder="https://twitter.com/yourpage" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label"><i class="fa fa-instagram me-2"></i>Instagram URL</label>
                        <input type="url" name="InstagramUrl" value="@(Model.ContainsKey("InstagramUrl") ? Model["InstagramUrl"] : "")" class="form-control" placeholder="https://instagram.com/yourpage" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label"><i class="fa fa-linkedin me-2"></i>LinkedIn URL</label>
                        <input type="url" name="LinkedInUrl" value="@(Model.ContainsKey("LinkedInUrl") ? Model["LinkedInUrl"] : "")" class="form-control" placeholder="https://linkedin.com/company/yourpage" />
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-2"></i>Save Settings
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
