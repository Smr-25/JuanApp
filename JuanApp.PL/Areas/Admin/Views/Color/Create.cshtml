@{
    ViewData["Title"] = "Create Color";
}

<div class="page-header">
    <h1 class="page-title">Create New Color</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Color">Colors</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-palette me-2"></i>Color Information</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }
                    
                    <div class="mb-3">
                        <label for="name" class="form-label">Color Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" name="name" placeholder="e.g., Red, Blue, Green" required />
                    </div>
                    
                    <div class="mb-3">
                        <label for="hexCode" class="form-label">Color Code <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color" id="hexCode" name="hexCode" value="#000000" title="Choose color">
                            <input type="text" class="form-control" id="hexCodeText" readonly value="#000000">
                        </div>
                        <small class="text-muted">Choose a color from the picker</small>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Preview</label>
                        <div class="d-flex align-items-center gap-3">
                            <div id="colorPreview" style="width: 80px; height: 80px; border: 2px solid #ddd; border-radius: 0.5rem; background-color: #000000;"></div>
                            <div>
                                <strong id="previewName">-</strong><br>
                                <small class="text-muted" id="previewCode">#000000</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between mt-4">
                        <a href="/Admin/Color" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Back
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-2"></i>Create Color
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const colorPicker = document.getElementById('hexCode');
        const colorText = document.getElementById('hexCodeText');
        const colorPreview = document.getElementById('colorPreview');
        const nameInput = document.getElementById('name');
        const previewName = document.getElementById('previewName');
        const previewCode = document.getElementById('previewCode');
        
        colorPicker.addEventListener('input', function() {
            const color = this.value;
            colorText.value = color;
            colorPreview.style.backgroundColor = color;
            previewCode.textContent = color;
        });
        
        nameInput.addEventListener('input', function() {
            previewName.textContent = this.value || '-';
        });
    </script>
    
    <partial name="_ValidationScriptsPartial" />
}

