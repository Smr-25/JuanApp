@model List<JuanApp.BLL.Dtos.ProductColorDto>

@{
    ViewData["Title"] = "Colors";
}

<div class="page-header">
    <h1 class="page-title">Colors</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
            <li class="breadcrumb-item active">Colors</li>
        </ol>
    </nav>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-palette me-2"></i>Color List (@(Model?.Count ?? 0))</h5>
        <a href="/Admin/Color/Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>New Color
        </a>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Preview</th>
                            <th>Name</th>
                            <th>Hex Code</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var color in Model)
                        {
                            <tr>
                                <td><strong>#@color.Id</strong></td>
                                <td>
                                    <div style="width: 40px; height: 40px; background-color: @color.HexCode; border: 2px solid #ddd; border-radius: 0.5rem;"></div>
                                </td>
                                <td><strong>@color.Name</strong></td>
                                <td><code>@color.HexCode</code></td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="/Admin/Color/Edit/@color.Id" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form action="/Admin/Color/Delete/@color.Id" method="post" class="d-inline" 
                                              data-confirm="Are you sure you want to delete this color?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-palette empty-state-icon"></i>
                <h3 class="empty-state-title">No colors yet</h3>
                <p class="empty-state-description">Add your first color</p>
                <a href="/Admin/Color/Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-2"></i>Add Color
                </a>
            </div>
        }
    </div>
</div>

