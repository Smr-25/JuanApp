@model dynamic

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">Home</li>
        </ol>
    </nav>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="stat-title">Products</p>
                    <h3 class="stat-value">@(ViewBag.ProductCount ?? 0)</h3>
                    <p class="stat-change positive">
                        <i class="bi bi-arrow-up"></i> +12.5%
                    </p>
                </div>
                <div class="stat-icon primary">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="stat-title">Orders</p>
                    <h3 class="stat-value">@(ViewBag.OrderCount ?? 0)</h3>
                    <p class="stat-change positive">
                        <i class="bi bi-arrow-up"></i> +8.2%
                    </p>
                </div>
                <div class="stat-icon success">
                    <i class="bi bi-cart-check"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="stat-title">Subscribers</p>
                    <h3 class="stat-value">@(ViewBag.SubscriberCount ?? 0)</h3>
                    <p class="stat-change positive">
                        <i class="bi bi-arrow-up"></i> +15.3%
                    </p>
                </div>
                <div class="stat-icon warning">
                    <i class="bi bi-envelope"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="stat-title">Revenue</p>
                    <h3 class="stat-value">₼@(ViewBag.TotalRevenue ?? 0)</h3>
                    <p class="stat-change negative">
                        <i class="bi bi-arrow-down"></i> -3.1%
                    </p>
                </div>
                <div class="stat-icon danger">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity & Stats -->
<div class="row g-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-cart-check me-2"></i>Recent Orders</h5>
                <a href="/Admin/Order" class="btn btn-sm btn-primary">View All</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(ViewBag.RecentOrders != null)
                            {
                                foreach(var order in ViewBag.RecentOrders)
                                {
                                    <tr>
                                        <td><strong>#@order.Id</strong></td>
                                        <td>@order.CustomerName</td>
                                        <td>₼@order.TotalPrice</td>
                                        <td>
                                            @if(order.Status == "Completed")
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else if(order.Status == "Processing")
                                            {
                                                <span class="badge bg-warning">Processing</span>
                                            }
                                            else if(order.Status == "Pending")
                                            {
                                                <span class="badge bg-info">Pending</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Cancelled</span>
                                            }
                                        </td>
                                        <td>@order.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            <a href="/Admin/Order/Details/@order.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                        <p class="mt-2">No orders yet</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Popular Products</h5>
            </div>
            <div class="card-body">
                @if(ViewBag.PopularProducts != null)
                {
                    <div class="list-group list-group-flush">
                        @foreach(var product in ViewBag.PopularProducts)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="/@product.ImageUrl" alt="@product.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 0.5rem;">
                                    <div>
                                        <h6 class="mb-0">@product.Name</h6>
                                        <small class="text-muted">@product.SalesCount sales</small>
                                    </div>
                                </div>
                                <span class="badge bg-primary rounded-pill">₼@product.Price</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center text-muted py-4">
                        <i class="bi bi-box-seam" style="font-size: 2rem;"></i>
                        <br>No data available
                    </p>
                }
            </div>
        </div>
    </div>
</div>

