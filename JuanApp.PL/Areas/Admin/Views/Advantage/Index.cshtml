@model List<JuanApp.BLL.Dtos.HomeAdvantageDto>

@{
    ViewData["Title"] = "Advantages";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-star me-2"></i>Advantages</h5>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Add Advantage
        </a>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Icon</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var advantage in Model)
                {
                    <tr>
                        <td>@advantage.Id</td>
                        <td><i class="@advantage.Icon fa-2x"></i></td>
                        <td><strong>@advantage.Name</strong></td>
                        <td>@advantage.Description</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@advantage.Id" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@advantage.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Are you sure?');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

