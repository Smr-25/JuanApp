@using JuanApp.Core.Models
@model ProductVm
@{
    ViewBag.Title = Model.ProductDetails.Product.Name;
    var product = Model.ProductDetails.Product;
    var relatedProducts = Model.ProductDetails.RelatedProducts;
    var reviews = product.Reviews ?? new List<ProductReview>();
    var avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 0;
}

<main>
    <!-- breadcrumb area start -->
    <div class="breadcrumb-area bg-img" data-bg="/assets/img/banner/breadcrumb-banner.jpg">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-wrap text-center">
                        <nav aria-label="breadcrumb">
                            <h1 class="breadcrumb-title">Product Details</h1>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index">Shop</a></li>
                                <li class="breadcrumb-item active" aria-current="page">@product.Name</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- breadcrumb area end -->

    <!-- product details wrapper start -->
    <div class="product-details-wrapper section-padding">
        <div class="container custom-container">
            <div class="row">
                <div class="col-12">
                    <!-- product details inner start -->
                    <div class="product-details-inner">
                        <div class="row">
                            <!-- Images -->
                            <div class="col-lg-5">
                                <div class="product-large-slider mb-20">
                                    @if (product.ProductImages != null && product.ProductImages.Any())
                                    {
                                        @foreach (var img in product.ProductImages)
                                        {
                                            <div class="pro-large-img img-zoom">
                                                <img src="/@img.ImageUrl" alt="@product.Name"/>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="pro-large-img img-zoom">
                                            <img src="/@product.ImageUrl" alt="@product.Name"/>
                                        </div>
                                    }
                                </div>

                                <div class="pro-nav slick-row-5">
                                    @if (product.ProductImages != null && product.ProductImages.Any())
                                    {
                                        @foreach (var img in product.ProductImages)
                                        {
                                            <div class="pro-nav-thumb">
                                                <img src="/@img.ImageUrl" alt="@product.Name"/>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Details -->
                            <div class="col-lg-7">
                                <div class="product-details-des">
                                    <h3 class="pro-det-title">@product.Name</h3>

                                    <div class="pro-review">
                                        <div class="rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= avgRating)
                                                {
                                                    <i class="fa fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-star-o"></i>
                                                }
                                            }
                                        </div>
                                        <span><a href="#reviews">@reviews.Count Review(s)</a></span>
                                    </div>

                                    <div class="price-box">
                                        @if (product.DiscountPercentage > 0)
                                        {
                                            var priceAfterDiscount = product.Price - (product.Price * product.DiscountPercentage / 100);
                                            <span class="regular-price">₼@priceAfterDiscount.ToString("F2")</span>
                                            <span class="old-price"><del>₼@product.Price.ToString("F2")</del></span>
                                        }
                                        else
                                        {
                                            <span class="regular-price">₼@product.Price.ToString("F2")</span>
                                        }
                                    </div>

                                    <p class="pro-desc">@product.Description</p>

                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <form id="addToCartForm">
                                            <input type="hidden" id="productId" value="@product.Id" />
                                            
                                            @if (product.Colors != null && product.Colors.Any())
                                            {
                                                <div class="color-option mb-20">
                                                    <h5 class="cat-title">Color:</h5>
                                                    <div class="color-selection-wrapper" style="display: flex; gap: 10px; flex-wrap: wrap;">
                                                        @foreach (var color in product.Colors)
                                                        {
                                                            <label class="color-selection-item" style="cursor: pointer; position: relative;">
                                                                <input type="radio" name="colorSelect" value="@color.Name" class="color-radio" style="position: absolute; opacity: 0;" />
                                                                <div class="color-box" style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 2px solid #ddd; border-radius: 6px; transition: all 0.3s;">
                                                                    <span class="color-preview" style="width: 25px; height: 25px; background-color: @color.HexCode; border: 1px solid #ccc; border-radius: 4px; display: inline-block;"></span>
                                                                    <span class="color-name" style="font-size: 14px; font-weight: 500;">@color.Name</span>
                                                                </div>
                                                            </label>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (product.Sizes != null && product.Sizes.Any())
                                            {
                                                <div class="size-option mb-20">
                                                    <h5 class="cat-title">Size:</h5>
                                                    <div class="size-selection-wrapper" style="display: flex; gap: 10px; flex-wrap: wrap;">
                                                        @foreach (var size in product.Sizes)
                                                        {
                                                            <label class="size-selection-item" style="cursor: pointer;">
                                                                <input type="radio" name="sizeSelect" value="@size.Name" class="size-radio" style="position: absolute; opacity: 0;" />
                                                                <div class="size-box" style="min-width: 50px; padding: 10px 16px; border: 2px solid #ddd; border-radius: 6px; text-align: center; font-weight: 600; transition: all 0.3s;">
                                                                    @size.Name
                                                                </div>
                                                            </label>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            <div class="quantity-cart-box d-flex align-items-center mb-20">
                                                <div class="quantity">
                                                    <div class="pro-qty">
                                                        <input type="text" id="quantity" value="1"/>
                                                    </div>
                                                </div>
                                                <button type="button" onclick="addToCart()" class="btn btn-default">Add To Cart</button>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            Please <a asp-controller="Account" asp-action="Login" class="alert-link">login</a> to add products to cart.
                                        </div>
                                    }

                                    <div class="availability mb-20">
                                        <h5 class="cat-title">Availability:</h5>
                                        @if (product.InStock)
                                        {
                                            <span class="text-success"><i class="fa fa-check"></i> In Stock</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger"><i class="fa fa-times"></i> Out of Stock</span>
                                        }
                                    </div>

                                    <div class="share-icon">
                                        <h5 class="cat-title">Share:</h5>
                                        <a href="#"><i class="fa fa-facebook"></i></a>
                                        <a href="#"><i class="fa fa-twitter"></i></a>
                                        <a href="#"><i class="fa fa-pinterest"></i></a>
                                        <a href="#"><i class="fa fa-instagram"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- product details inner end -->

                    <!-- product details reviews start -->
                    <div class="product-details-reviews section-padding">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="product-review-info">
                                    <ul class="nav review-tab">
                                        <li>
                                            <a class="active" data-toggle="tab" href="#tab_one">Description</a>
                                        </li>
                                        <li>
                                            <a data-toggle="tab" href="#tab_two">Information</a>
                                        </li>
                                        <li>
                                            <a data-toggle="tab" href="#tab_three" id="reviews">Reviews (@reviews.Count)</a>
                                        </li>
                                    </ul>
                                    <div class="tab-content reviews-tab">
                                        <!-- Description Tab -->
                                        <div class="tab-pane fade show active" id="tab_one">
                                            <div class="tab-one">
                                                <p>@product.Description</p>
                                            </div>
                                        </div>
                                        
                                        <!-- Information Tab -->
                                        <div class="tab-pane fade" id="tab_two">
                                            <table class="table table-bordered">
                                                <tbody>
                                                    @if (product.Colors != null && product.Colors.Any())
                                                    {
                                                        <tr>
                                                            <td><strong>Available Colors</strong></td>
                                                            <td>@string.Join(", ", product.Colors.Select(c => c.Name))</td>
                                                        </tr>
                                                    }
                                                    @if (product.Sizes != null && product.Sizes.Any())
                                                    {
                                                        <tr>
                                                            <td><strong>Available Sizes</strong></td>
                                                            <td>@string.Join(", ", product.Sizes.Select(s => s.Name))</td>
                                                        </tr>
                                                    }
                                                    <tr>
                                                        <td><strong>Category</strong></td>
                                                        <td>@product.Category?.Name</td>
                                                    </tr>
                                                    <tr>
                                                        <td><strong>Stock Status</strong></td>
                                                        <td>@(product.InStock ? "In Stock" : "Out of Stock")</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        
                                        <!-- Reviews Tab -->
                                        <div class="tab-pane fade" id="tab_three">
                                            @if (reviews.Any())
                                            {
                                                <h5>@reviews.Count review(s) for <span>@product.Name</span></h5>
                                                
                                                @foreach (var review in reviews.OrderByDescending(r => r.CreatedAt))
                                                {
                                                    <div class="total-reviews mb-30" id="review-@review.Id">
                                                        <div class="review-box">
                                                            <div class="d-flex justify-content-between align-items-start">
                                                                <div class="post-author">
                                                                    <p><span>@review.UserName -</span> @review.CreatedAt.ToString("MMMM dd, yyyy")</p>
                                                                </div>
                                                                @if (User.Identity?.IsAuthenticated == true && review.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                                                                {
                                                                    <button type="button" onclick="deleteReview(@review.Id)" class="btn btn-sm btn-danger">
                                                                        <i class="fa fa-trash"></i> Delete
                                                                    </button>
                                                                }
                                                            </div>
                                                            <div class="rating-box">
                                                                @for (int i = 1; i <= 5; i++)
                                                                {
                                                                    if (i <= review.Rating)
                                                                    {
                                                                        <i class="fa fa-star"></i>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="fa fa-star-o"></i>
                                                                    }
                                                                }
                                                            </div>
                                                            <div class="review-details">
                                                                <p>@review.Comment</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p>No reviews yet.</p>
                                            }

                                            @if (User.Identity?.IsAuthenticated == true)
                                            {
                                                <form id="reviewForm" class="review-form mt-40">
                                                    <h5>Add a review</h5>
                                                    <input type="hidden" id="reviewProductId" value="@product.Id" />
                                                    
                                                    <div class="row">
                                                        <div class="col-12">
                                                            <div class="form-group">
                                                                <label>Your Rating <span class="required">*</span></label>
                                                                <div class="rating-stars">
                                                                    <select id="reviewRating" class="form-control" required>
                                                                        <option value="">Select Rating</option>
                                                                        <option value="5">5 Stars - Excellent</option>
                                                                        <option value="4">4 Stars - Good</option>
                                                                        <option value="3">3 Stars - Average</option>
                                                                        <option value="2">2 Stars - Poor</option>
                                                                        <option value="1">1 Star - Terrible</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <div class="form-group">
                                                                <label>Your Review <span class="required">*</span></label>
                                                                <textarea id="reviewComment" class="form-control" rows="4" required></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <button type="button" onclick="submitReview()" class="btn btn-default">Submit Review</button>
                                                        </div>
                                                    </div>
                                                </form>
                                            }
                                            else
                                            {
                                                <div class="alert alert-info mt-40">
                                                    Please <a asp-controller="Account" asp-action="Login" class="alert-link">login</a> to write a review.
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- product details reviews end -->
                </div>
            </div>

            <!-- Related Products -->
            @if (relatedProducts != null && relatedProducts.Any())
            {
                <section class="related-products section-padding">
                    <div class="row">
                        <div class="col-12">
                            <div class="section-title mb-30">
                                <h2 class="title">Related Products</h2>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        @foreach (var item in relatedProducts)
                        {
                            var itemImage = item.ProductImages?.FirstOrDefault()?.ImageUrl ?? item.ImageUrl;
                            <div class="col-lg-3 col-md-6">
                                <div class="product-item mb-30">
                                    <div class="product-thumb">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">
                                            <img src="/@itemImage" alt="@item.Name">
                                        </a>
                                        @if (item.DiscountPercentage > 0)
                                        {
                                            <span class="badges">
                                                <span class="sale">-@item.DiscountPercentage%</span>
                                            </span>
                                        }
                                    </div>
                                    <div class="product-content">
                                        <h5 class="product-name">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                                        </h5>
                                        <div class="price-box">
                                            @if (item.DiscountPercentage > 0)
                                            {
                                                var discPrice = item.Price - (item.Price * item.DiscountPercentage / 100);
                                                <span class="regular-price">₼@discPrice.ToString("F2")</span>
                                                <span class="old-price"><del>₼@item.Price.ToString("F2")</del></span>
                                            }
                                            else
                                            {
                                                <span class="regular-price">₼@item.Price.ToString("F2")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    </div>
    <!-- product details wrapper end -->
</main>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Color selection styling
            $('.color-radio').on('change', function() {
                $('.color-box').css({'border-color': '#ddd', 'background': 'transparent'});
                $(this).siblings('.color-box').css({'border-color': '#333', 'background': '#f8f8f8'});
            });

            // Size selection styling
            $('.size-radio').on('change', function() {
                $('.size-box').css({'border-color': '#ddd', 'background': 'white', 'color': '#333'});
                $(this).siblings('.size-box').css({'border-color': '#333', 'background': '#333', 'color': 'white'});
            });
        });

        // Add to Cart Function
        function addToCart() {
            const productId = document.getElementById('productId').value;
            const quantity = parseInt(document.getElementById('quantity').value) || 1;
            const colorRadio = document.querySelector('input[name="colorSelect"]:checked');
            const sizeRadio = document.querySelector('input[name="sizeSelect"]:checked');
            const color = colorRadio ? colorRadio.value : '';
            const size = sizeRadio ? sizeRadio.value : '';

            const data = {
                productId: parseInt(productId),
                quantity: quantity,
                selectedColor: color,
                selectedSize: size
            };

            fetch('/Basket/AddToBasket', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    toastr.success('Product added to cart!');
                    updateCartCount();
                } else {
                    toastr.error(result.message || 'Failed to add to cart');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                toastr.error('An error occurred');
            });
        }

        // Submit Review Function
        function submitReview() {
            const productId = document.getElementById('reviewProductId').value;
            const rating = document.getElementById('reviewRating').value;
            const comment = document.getElementById('reviewComment').value;

            if (!rating || !comment) {
                toastr.warning('Please fill all fields');
                return;
            }

            const data = {
                productId: parseInt(productId),
                rating: parseInt(rating),
                comment: comment
            };

            fetch('/Product/AddReview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    toastr.success('Review submitted successfully!');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    toastr.error(result.message || 'Failed to submit review');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                toastr.error('An error occurred');
            });
        }

        // Delete Review Function
        function deleteReview(reviewId) {
            if (!confirm('Are you sure you want to delete this review?')) {
                return;
            }

            fetch('/Product/DeleteReview?id=' + reviewId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    toastr.success('Review deleted successfully!');
                    document.getElementById('review-' + reviewId).remove();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    toastr.error(result.message || 'Failed to delete review');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                toastr.error('An error occurred');
            });
        }
    </script>
}

