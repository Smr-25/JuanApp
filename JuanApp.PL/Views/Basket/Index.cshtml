@model JuanApp.BLL.Dtos.BasketDto

<main>
    <!-- breadcrumb -->
    <div class="breadcrumb-area bg-img" data-bg="~/assets/img/banner/breadcrumb-banner.jpg">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-wrap text-center">
                        <nav aria-label="breadcrumb">
                            <h1 class="breadcrumb-title">Cart</h1>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Cart</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- cart main wrapper -->
    <div class="cart-main-wrapper section-padding">
        <div class="container">
            <div class="section-bg-color">
                @if (Model.Items.Any())
                {
                    <div class="row">
                        <div class="col-lg-12">
                            <!-- Cart Table -->
                            <div class="cart-table table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th class="pro-thumbnail">Thumbnail</th>
                                            <th class="pro-title">Product</th>
                                            <th class="pro-price">Price</th>
                                            <th class="pro-quantity">Quantity</th>
                                            <th class="pro-subtotal">Total</th>
                                            <th class="pro-remove">Remove</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr data-item-id="@item.Id">
                                                <td class="pro-thumbnail">
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                                                        <img class="img-fluid" src="~/assets/img/product/@item.ProductImage" alt="@item.ProductName" />
                                                    </a>
                                                </td>
                                                <td class="pro-title">
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                                                        @item.ProductName
                                                    </a>
                                                    @if (!string.IsNullOrEmpty(item.ColorName) || !string.IsNullOrEmpty(item.SizeName))
                                                    {
                                                        <br />
                                                        <small class="text-muted">
                                                            @if (!string.IsNullOrEmpty(item.ColorName))
                                                            {
                                                                <span>Color: @item.ColorName</span>
                                                            }
                                                            @if (!string.IsNullOrEmpty(item.SizeName))
                                                            {
                                                                <span> | Size: @item.SizeName</span>
                                                            }
                                                        </small>
                                                    }
                                                </td>
                                                <td class="pro-price"><span>$@item.Price.ToString("F2")</span></td>
                                                <td class="pro-quantity">
                                                    <div class="pro-qty">
                                                        <input type="text" value="@item.Quantity" 
                                                               data-item-id="@item.Id"
                                                               class="quantity-input"
                                                               onchange="updateQuantity(@item.Id, this.value)">
                                                    </div>
                                                </td>
                                                <td class="pro-subtotal">
                                                    <span class="subtotal-@item.Id">$@item.Subtotal.ToString("F2")</span>
                                                </td>
                                                <td class="pro-remove">
                                                    <a href="javascript:void(0)" onclick="removeItem(@item.Id)">
                                                        <i class="fa fa-trash-o"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Cart Update Option -->
                            <div class="cart-update-option d-block d-md-flex justify-content-between">
                                <div class="apply-coupon-wrapper">
                                    <form action="#" method="post" class="d-block d-md-flex">
                                        <input type="text" placeholder="Enter Your Coupon Code" />
                                        <button class="btn" type="button">Apply Coupon</button>
                                    </form>
                                </div>
                                <div class="cart-update">
                                    <a asp-action="Index" class="btn">Update Cart</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-5 ml-auto">
                            <!-- Cart Totals -->
                            <div class="cart-calculator-wrapper">
                                <div class="cart-calculate-items">
                                    <h3>Cart Totals</h3>
                                    <div class="table-responsive">
                                        <table class="table">
                                            <tr>
                                                <td>Sub Total</td>
                                                <td id="cart-subtotal">$@Model.TotalPrice.ToString("F2")</td>
                                            </tr>
                                            <tr>
                                                <td>Shipping</td>
                                                <td>$0.00</td>
                                            </tr>
                                            <tr class="total">
                                                <td>Total</td>
                                                <td class="total-amount" id="cart-total">$@Model.TotalPrice.ToString("F2")</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <a asp-controller="Basket" asp-action="Checkout" class="btn d-block">Proceed to Checkout</a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="text-center py-5">
                                <i class="fa fa-shopping-cart" style="font-size: 80px; color: #ccc;"></i>
                                <h3 class="mt-3">Your cart is empty</h3>
                                <p class="text-muted">Add some products to your cart and they will appear here.</p>
                                <a asp-controller="Shop" asp-action="Index" class="btn mt-3">Continue Shopping</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        function updateQuantity(itemId, quantity) {
            if (quantity < 1) {
                alert('Quantity must be at least 1');
                return;
            }

            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Basket")',
                type: 'POST',
                data: { basketItemId: itemId, quantity: quantity },
                success: function(response) {
                    if (response.success) {
                        // Update subtotal
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('An error occurred');
                }
            });
        }

        function removeItem(itemId) {
            if (!confirm('Are you sure you want to remove this item?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("Remove", "Basket")',
                type: 'POST',
                data: { basketItemId: itemId },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('An error occurred');
                }
            });
        }
    </script>
}