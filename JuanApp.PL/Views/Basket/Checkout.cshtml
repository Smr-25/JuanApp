@{
    ViewBag.Title = "Checkout";
}

<main>
    <div class="breadcrumb-area bg-img" data-bg="/assets/img/banner/breadcrumb-banner.jpg">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-wrap text-center">
                        <nav aria-label="breadcrumb">
                            <h1 class="breadcrumb-title">Checkout</h1>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li class="breadcrumb-item active">Checkout</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="checkout-main-area section-padding">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="returning-customer">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <p>Returning customer? <a asp-controller="Account" asp-action="Login">Click here to login</a></p>
                        }
                    </div>
                </div>
            </div>

            <form id="checkoutForm">
                <div class="row">
                    <div class="col-lg-7">
                        <div class="billing-info-wrap">
                            <h3>Billing Details</h3>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="billing-info mb-20">
                                        <label>Full Name <span class="required">*</span></label>
                                        <input type="text" id="fullName" required />
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="billing-info mb-20">
                                        <label>Email Address <span class="required">*</span></label>
                                        <input type="email" id="email" required />
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="billing-info mb-20">
                                        <label>Phone <span class="required">*</span></label>
                                        <input type="text" id="phone" required />
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="billing-info mb-20">
                                        <label>Street Address <span class="required">*</span></label>
                                        <input type="text" id="address" placeholder="House number and street name" required />
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="billing-info mb-20">
                                        <label>City <span class="required">*</span></label>
                                        <input type="text" id="city" required />
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="billing-info mb-20">
                                        <label>Postcode / ZIP</label>
                                        <input type="text" id="zipCode" />
                                    </div>
                                </div>
                            </div>
                            <div class="checkout-account mt-25">
                                <input class="checkout-toggle" type="checkbox" id="subscribeCheckbox">
                                <label>Subscribe to our newsletter</label>
                            </div>
                            <div class="additional-info-wrap">
                                <label>Order notes</label>
                                <textarea id="orderNotes" placeholder="Notes about your order, e.g. special notes for delivery."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="your-order-area">
                            <h3>Your order</h3>
                            <div class="your-order-wrap gray-bg-4">
                                <div class="your-order-info-wrap">
                                    <div class="your-order-info">
                                        <ul>
                                            <li>Product <span>Total</span></li>
                                        </ul>
                                    </div>
                                    <div class="your-order-middle" id="orderItems">
                                        <ul>
                                            <li>Loading cart items...</li>
                                        </ul>
                                    </div>
                                    <div class="your-order-info order-subtotal">
                                        <ul>
                                            <li>Subtotal <span id="subtotal">₼0.00</span></li>
                                        </ul>
                                    </div>
                                    <div class="your-order-info order-shipping">
                                        <ul>
                                            <li>Shipping <span>Free shipping</span></li>
                                        </ul>
                                    </div>
                                    <div class="your-order-info order-total">
                                        <ul>
                                            <li>Total <span id="total">₼0.00</span></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="payment-method">
                                    <div class="pay-top sin-payment">
                                        <input id="payment_method_1" class="input-radio" type="radio" value="cash" checked="checked" name="payment_method">
                                        <label for="payment_method_1">Cash on delivery</label>
                                    </div>
                                    <div class="pay-top sin-payment">
                                        <input id="payment_method_2" class="input-radio" type="radio" value="card" name="payment_method">
                                        <label for="payment_method_2">Credit Card</label>
                                        <div class="payment-box payment_method_bacs">
                                            <p>Make your payment directly via credit card.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="Place-order mt-40">
                                <button type="button" onclick="placeOrder()" class="btn-hover">Place Order</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        $(document).ready(function() {
            loadUserInfo();
            loadCartItems();
        });

        function loadUserInfo() {
            @if (User.Identity.IsAuthenticated)
            {
                @:$('#fullName').val('@User.Identity.Name');
                @:$('#email').val('@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value');
            }
        }

        function loadCartItems() {
            $.ajax({
                url: '/Basket/GetBasketItems',
                type: 'GET',
                success: function(response) {
                    if (response.success && response.items && response.items.length > 0) {
                        let html = '<ul>';
                        let subtotal = 0;
                        
                        response.items.forEach(function(item) {
                            const itemTotal = item.price * item.quantity;
                            subtotal += itemTotal;
                            
                            html += '<li>' + item.productName + ' X ' + item.quantity + ' <span>₼' + itemTotal.toFixed(2) + '</span></li>';
                        });
                        
                        html += '</ul>';
                        $('#orderItems').html(html);
                        $('#subtotal').text('₼' + subtotal.toFixed(2));
                        $('#total').text('₼' + subtotal.toFixed(2));
                    } else {
                        $('#orderItems').html('<ul><li>Your cart is empty</li></ul>');
                        window.location.href = '/Basket';
                    }
                },
                error: function() {
                    toastr.error('Failed to load cart items');
                }
            });
        }

        function placeOrder() {
            const fullName = $('#fullName').val();
            const email = $('#email').val();
            const phone = $('#phone').val();
            const address = $('#address').val();
            const city = $('#city').val();
            const zipCode = $('#zipCode').val();
            const orderNotes = $('#orderNotes').val();
            const subscribe = $('#subscribeCheckbox').is(':checked');

            if (!fullName || !email || !phone || !address || !city) {
                toastr.warning('Please fill all required fields');
                return;
            }

            const orderData = {
                fullName: fullName,
                email: email,
                phone: phone,
                address: address + ', ' + city + (zipCode ? ', ' + zipCode : ''),
                notes: orderNotes,
                subscribe: subscribe
            };

            $.ajax({
                url: '/Basket/Checkout',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(orderData),
                success: function(response) {
                    if (response.success) {
                        toastr.success('Order placed successfully!');
                        setTimeout(function() {
                            window.location.href = '/Account/Profile';
                        }, 1500);
                    } else {
                        toastr.error(response.message || 'Failed to place order');
                    }
                },
                error: function() {
                    toastr.error('An error occurred. Please try again.');
                }
            });
        }
    </script>
}

