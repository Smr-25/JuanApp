@model UserLoginVm
@{
    Layout = "_Layout";
}

<div class="justify-content-center m-3">
    <div class="login-reg-form-wrap">
        <h2>Sign In</h2>
        <form action="#" method="post">
            <div class="single-input-item">
                <label asp-for="accountLoginDto.UsernameOrEmail"></label>
                <input asp-for="accountLoginDto.UsernameOrEmail"/>
            </div>
            <span asp-validation-for="accountLoginDto.UsernameOrEmail" class="text-danger"></span>
            <div class="single-input-item">
                <label asp-for="accountLoginDto.Password"></label>
                <input asp-for="accountLoginDto.Password"/>
            </div>
            <span asp-validation-for="accountLoginDto.Password" class="text-danger"></span>

            <div class="single-input-item">
                <div class="login-reg-form-meta d-flex align-items-center justify-content-between">
                    <div class="remember-meta">
                        <div class="custom-control custom-checkbox">
                            <label asp-for="accountLoginDto.RememberMe"></label>
                            <input asp-for="accountLoginDto.RememberMe">
                        </div>
                     </div>
                    <a asp-controller="Account" asp-action="ForgotPassword" class="forget-pwd">Forget Password?</a>
                </div>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div> 
            <div class="single-input-item">
                <button class="btn">Login</button>
            </div>
        </form>
    </div>
</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial"/>
}