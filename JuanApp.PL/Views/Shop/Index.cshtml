@model ShopVm

<main>
    <!-- breadcrumb -->
    <div class="breadcrumb-area bg-img" data-bg="assets/img/banner/breadcrumb-banner.jpg">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-wrap text-center">
                        <nav aria-label="breadcrumb">
                            <h1 class="breadcrumb-title">Shop</h1>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Shop</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="shop-main-wrapper section-padding">
        <div class="container">
            <div class="row">

                <!-- sidebar -->
                <div class="col-lg-3 order-2 order-lg-1">
                    <div class="sidebar-wrapper">

                        <!-- Categories -->
                        <div class="sidebar-single">
                            <div class="sidebar-title"><h3>Categories</h3></div>
                            <div class="sidebar-body">
                                <ul class="color-list">
                                    <li>
                                        <a asp-action="Index">All Products</a>
                                    </li>
                                    @foreach (var category in Model.Categories)
                                    {
                                    <li>
                                        <a asp-action="Index" asp-route-categoryId="@category.Id">
                                            @category.Name <span>(@category.ProductCount)</span>
                                        </a>
                                    </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <!-- Price Filter -->
                        <div class="sidebar-single">
                            <div class="sidebar-title"><h3>filter by price</h3></div>
                            <div class="sidebar-body">
                                <div class="price-range-wrap">
                                    <div class="price-range" data-min="20" data-max="400"></div>
                                    <div class="range-slider">
                                        <form asp-action="Index" method="get" id="priceFilterForm">
                                            <input type="hidden" name="categoryId" value="@Model.Filter.CategoryId" />
                                            <input type="hidden" name="sortBy" value="@Model.Filter.SortBy" />

                                            @if(Model.Filter.ColorId != null)
                                            {
                                            @foreach(var colorId in Model.Filter.ColorId)
                                            {
                                            <input type="hidden" name="colorIds" value="@colorId" />
                                            }
                                            }

                                            @if(Model.Filter.SizeId != null)
                                            {
                                            @foreach(var sizeId in Model.Filter.SizeId)
                                            {
                                            <input type="hidden" name="sizeIds" value="@sizeId" />
                                            }
                                            }

                                            <input type="hidden" id="minPrice" name="minPrice" value="@(Model.Filter.MinPrice ?? 20)" />
                                            <input type="hidden" id="maxPrice" name="maxPrice" value="@(Model.Filter.MaxPrice ?? 400)" />
                                            <div class="price-input">
                                                <label for="amount">Price: </label>
                                                <input type="text" id="amount" readonly>
                                            </div>
                                            <button type="submit" class="filter-btn">filter</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Colors -->
                        <div class="sidebar-single">
                            <div class="sidebar-title"><h3>Color</h3></div>
                            <div class="sidebar-body">
                                <ul class="color-list">
                                    @foreach (var color in Model.Colors)
                                    {
                                    <li>
                                        <a href="javascript:void(0)" onclick="toggleFilter('color', @color.Id)">
                                            @color.Name <span>(@color.ProductCount)</span>
                                        </a>
                                    </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <!-- Sizes -->
                        <div class="sidebar-single">
                            <div class="sidebar-title"><h3>Size</h3></div>
                            <div class="sidebar-body">
                                <ul class="size-list">
                                    @foreach (var size in Model.Sizes)
                                    {
                                    <li>
                                        <a href="javascript:void(0)" onclick="toggleFilter('size', @size.Id)">
                                            @size.Name <span>(@size.ProductCount)</span>
                                        </a>
                                    </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <!-- Banner -->
                        <div class="sidebar-single">
                            <div class="sidebar-banner">
                                <a href="#">
                                    <img src="~/assets/img/banner/banner_left.jpg" alt="">
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
                <!-- sidebar end -->

                <!-- shop products -->
                <div class="col-lg-9 order-1 order-lg-2">
                    <div class="shop-product-wrapper">
                        <div class="shop-top-bar">
                            <div class="row">
                                <div class="col-xl-5 col-lg-4 col-md-3 order-2 order-md-1">
                                    <div class="top-bar-left">
                                        <div class="product-view-mode">
                                            <a class="active" href="#" data-target="grid-view"><i class="fa fa-th"></i></a>
                                            <a href="#" data-target="list-view"><i class="fa fa-list"></i></a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-7 col-lg-8 col-md-9 order-1 order-md-2">
                                    <div class="top-bar-right">
                                        <div class="product-short">
                                            <p>Sort By : </p>
                                            <form method="get" id="sortForm">
                                                <input type="hidden" name="categoryId" value="@Model.Filter.CategoryId" />
                                                <input type="hidden" name="minPrice" value="@Model.Filter.MinPrice" />
                                                <input type="hidden" name="maxPrice" value="@Model.Filter.MaxPrice" />

                                                <select name="sortBy" class="nice-select" onchange="this.form.submit()">
                                                    <option value="relevance" selected="@(Model.Filter.SortBy == "relevance")">Relevance</option>
                                                    <option value="name-asc" selected="@(Model.Filter.SortBy == "name-asc")">Name (A - Z)</option>
                                                    <option value="name-desc" selected="@(Model.Filter.SortBy == "name-desc")">Name (Z - A)</option>
                                                    <option value="price-asc" selected="@(Model.Filter.SortBy == "price-asc")">Price (Low > High)</option>
                                                    <option value="price-desc" selected="@(Model.Filter.SortBy == "price-desc")">Price (High > Low)</option>
                                                </select>
                                            </form>
                                        </div>
                                        <div class="product-amount">
                                            @if(Model.TotalCount > 0)
                                            {
                                            var start = ((Model.CurrentPage - 1) * Model.Filter.PageSize) + 1;
                                            var end = Math.Min(Model.CurrentPage * Model.Filter.PageSize, Model.TotalCount);
                                            <p>Showing @start–@end of @Model.TotalCount results</p>
                                            }
                                            else
                                            {
                                            <p>No products found</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- product item list -->
                        <div class="shop-product-wrap grid-view row mbn-50">
                            @foreach(var product in Model.Products)
                            {
                            <div class="col-lg-4 col-sm-6">
                                <!-- product grid item -->
                                <div class="product-item mb-53">
                                    <div class="product-thumb">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                            <img src="~/assets/img/product/@product.ImageUrl" alt="@product.Name" />
                                        </a>
                                    </div>
                                    <div class="product-content">
                                        <h5 class="product-name">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                                @product.Name
                                            </a>
                                        </h5>
                                        <div class="price-box">
                                            @if(product.DiscountPercentage > 0)
                                            {
                                            var discountedPrice = product.Price - (product.Price * product.DiscountPercentage / 100);
                                            <span class="price-regular">$@discountedPrice.ToString("F2")</span>
                                            <span class="price-old"><del>$@product.Price.ToString("F2")</del></span>
                                            }
                                            else
                                            {
                                            <span class="price-regular">$@product.Price.ToString("F2")</span>
                                            }
                                        </div>
                                        <div class="product-action-link">
                                            <a href="#" data-toggle="tooltip" title="Wishlist">
                                                <i class="ion-android-favorite-outline"></i>
                                            </a>
                                            <a href="#" data-toggle="tooltip" title="Add To Cart">
                                                <i class="ion-bag"></i>
                                            </a>
                                            <a href="#" data-toggle="modal" data-target="#quick_view">
                                                    <span data-toggle="tooltip" title="Quick View">
                                                        <i class="ion-ios-eye-outline"></i>
                                                    </span>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- product list item -->
                                <div class="product-list-item mb-30">
                                    <div class="product-thumb">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                            <img src="~/assets/img/product/@product.ImageUrl" alt="@product.Name">
                                        </a>
                                    </div>
                                    <div class="product-content-list">
                                        <h5 class="product-name">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                                @product.Name
                                            </a>
                                        </h5>
                                        <div class="price-box">
                                            @if(product.DiscountPercentage > 0)
                                            {
                                            var discountedPrice = product.Price - (product.Price * product.DiscountPercentage / 100);
                                            <span class="price-regular">$@discountedPrice.ToString("F2")</span>
                                            <span class="price-old"><del>$@product.Price.ToString("F2")</del></span>
                                            }
                                            else
                                            {
                                            <span class="price-regular">$@product.Price.ToString("F2")</span>
                                            }
                                        </div>
                                        <p>@product.Description</p>
                                        <div class="product-link-2 position-static">
                                            <a href="#" data-toggle="tooltip" title="Wishlist">
                                                <i class="ion-android-favorite-outline"></i>
                                            </a>
                                            <a href="#" data-toggle="tooltip" title="Add To Cart">
                                                <i class="ion-bag"></i>
                                            </a>
                                            <a href="#" data-toggle="modal" data-target="#quick_view">
                                                    <span data-toggle="tooltip" title="Quick View">
                                                        <i class="ion-ios-eye-outline"></i>
                                                    </span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            }
                        </div>

                        <!-- pagination -->
                        <!-- pagination -->
                        @if(Model.TotalPages > 1)
                        {
                        <div class="paginatoin-area text-center mt-45">
                            <ul class="pagination-box">
                                @if(Model.CurrentPage > 1)
                                {
                                <li>
                                    <a href="javascript:void(0)" onclick="goToPage(@(Model.CurrentPage - 1))" class="Previous">
                                        <i class="ion-ios-arrow-left"></i>
                                    </a>
                                </li>
                                }

                                @for(int i = 1; i <= Model.TotalPages; i++)
                                {
                                <li class="@(i == Model.CurrentPage ? "active" : "")">
                                    @if(i == Model.CurrentPage)
                                    {
                                    <a href="javascript:void(0)" style="pointer-events: none; opacity: 1;">@i</a>
                                    }
                                    else
                                    {
                                    <a href="javascript:void(0)" onclick="goToPage(@i)">@i</a>
                                    }
                                </li>
                                }

                                @if(Model.CurrentPage < Model.TotalPages)
                                {
                                <li>
                                    <a href="javascript:void(0)" onclick="goToPage(@(Model.CurrentPage + 1))" class="Next">
                                        <i class="ion-ios-arrow-right"></i>
                                    </a>
                                </li>
                                }
                            </ul>
                        </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden form for color/size filters -->
    <form id="filterForm" asp-action="Index" method="get" style="display:none;">
        <input type="hidden" name="categoryId" value="@Model.Filter.CategoryId" />
        <input type="hidden" name="minPrice" value="@Model.Filter.MinPrice" />
        <input type="hidden" name="maxPrice" value="@Model.Filter.MaxPrice" />
        <input type="hidden" name="sortBy" value="@Model.Filter.SortBy" />
        <div id="colorInputs"></div>
        <div id="sizeInputs"></div>
    </form>
</main>

@section Scripts {
<script>
    // Price slider - template-in öz slider-i işləyəcək
    document.addEventListener('DOMContentLoaded', function() {
        var minPrice = @(Model.Filter.MinPrice ?? 20);
        var maxPrice = @(Model.Filter.MaxPrice ?? 400);

        // Slider dəyərlərini set edirik
        if (typeof $ !== 'undefined' && $('.price-range').length) {
            $('.price-range').slider('values', [minPrice, maxPrice]);
            $('#amount').val('$' + minPrice + ' - $' + maxPrice);
        }
    });

    // Color and Size filters
    var selectedColors = @Html.Raw(Model.Filter.ColorId != null ? "[" + string.Join(",", Model.Filter.ColorId) + "]" : "[]");
    var selectedSizes = @Html.Raw(Model.Filter.SizeId != null ? "[" + string.Join(",", Model.Filter.SizeId) + "]" : "[]");

    function toggleFilter(type, id) {
        var array = type === 'color' ? selectedColors : selectedSizes;
        var index = array.indexOf(id);

        if (index > -1) {
            array.splice(index, 1);
        } else {
            array.push(id);
        }

        applyFilters();
    }

    function applyFilters() {
        var form = document.getElementById('filterForm');
        var colorDiv = document.getElementById('colorInputs');
        var sizeDiv = document.getElementById('sizeInputs');

        colorDiv.innerHTML = '';
        sizeDiv.innerHTML = '';

        selectedColors.forEach(function(id) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'colorIds';
            input.value = id;
            colorDiv.appendChild(input);
        });

        selectedSizes.forEach(function(id) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'sizeIds';
            input.value = id;
            sizeDiv.appendChild(input);
        });

        form.submit();
    }

    // Pagination function
    function goToPage(pageNumber) {
        var url = '@Url.Action("Index")?page=' + pageNumber;

        @if(Model.Filter.CategoryId.HasValue)
        {
        @:url += '&categoryId=@Model.Filter.CategoryId';
        }

        @if(Model.Filter.MinPrice.HasValue)
        {
        @:url += '&minPrice=@Model.Filter.MinPrice';
        }

        @if(Model.Filter.MaxPrice.HasValue)
        {
        @:url += '&maxPrice=@Model.Filter.MaxPrice';
        }

        @if(!string.IsNullOrEmpty(Model.Filter.SortBy))
        {
        @:url += '&sortBy=@Model.Filter.SortBy';
        }

        // Add colors
        selectedColors.forEach(function(id) {
            url += '&colorIds=' + id;
        });

        // Add sizes
        selectedSizes.forEach(function(id) {
            url += '&sizeIds=' + id;
        });

        window.location.href = url;
    }
</script>
}