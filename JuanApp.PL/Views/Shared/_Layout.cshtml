@inject ILayoutService layoutService
@{
    ViewBag.Title = "Juan E-commerce Template";
    var settings = await layoutService.GetSettingsAsync();
}

<!DOCTYPE html>
<html class="no-js" lang="zxx">
<head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content="meta description"/>
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="~/assets/img/favicon.ico" type="image/x-icon"/>
    <link href="~/assets/css/plugins.css" rel="stylesheet"/>
    <link href="~/assets/css/vendor.css" rel="stylesheet"/>
    <link href="~/assets/css/style.css" rel="stylesheet"/>
    
    <!-- Toastr CSS (for notifications) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    
    <style>
        .cart-count {
            position: absolute;
            top: -8px;
            right: -10px;
            background: #e74c3c;
            color: white;
            border-radius: 50%;
            min-width: 20px;
            height: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
            padding: 2px 5px;
        }
        .minicart-btn {
            position: relative;
        }
    </style>
    
    <script src="~/assets/js/modernizr-2.8.3.min.js"></script>
</head>

<body>
<!-- Start Header Area -->
<header class="header-area">
    <!-- main header start -->
    <div class="main-header d-none d-lg-block">
        <!-- header top start -->
        <div class="header-top theme-bg">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <div class="welcome-message">
                            <p>Welcome to Juan online store</p>
                        </div>
                    </div>
                    <div class="col-lg-6 text-right">
                        <div class="header-top-settings">
                            <ul class="nav align-items-center justify-content-end">
                                <li class="curreny-wrap">
                                    $ Dollar (US)
                                    <i class="fa fa-angle-down"></i>
                                    <ul class="dropdown-list curreny-list">
                                        <li><a href="#">$ usd</a></li>
                                        <li><a href="#"> € EURO</a></li>
                                    </ul>
                                </li>
                                <li class="language">
                                    <img src="~/assets/img/icon/en.png" alt="flag"/> English
                                    <i class="fa fa-angle-down"></i>
                                    <ul class="dropdown-list">
                                        <li>
                                            <a href="#">
                                                <img src="~/assets/img/icon/en.png" alt="flag"/>
                                                english
                                            </a>
                                        </li>
                                        <li>
                                            <a href="#">
                                                <img src="~/assets/img/icon/fr.png" alt="flag"/>
                                                french
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- header top end -->
        
        <!-- header middle area start -->
        <div class="header-main-area sticky">
            <div class="container">
                <div class="row align-items-center position-relative">
                    <!-- start logo area -->
                    <div class="col-lg-2">
                        <div class="logo">
                            <a asp-controller="Home" asp-action="Index">
                                <img src="~/assets/img/logo/@settings["Logo"]" alt=""/>
                            </a>
                        </div>
                    </div>
                    <!-- start logo area -->
                    
                    <!-- main menu area start -->
                    <div class="col-lg-8 position-static">
                        <div class="main-menu-area">
                            <div class="main-menu">
                                <nav class="desktop-menu">
                                    <ul>
                                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                        <li><a asp-controller="Shop" asp-action="Index">Shop</a></li>
                                        <li><a href="#">Blog</a></li>
                                        <li><a href="#">Contact us</a></li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                    <!-- main menu area end -->
                    
                    <!-- mini cart area start -->
                    <div class="col-lg-2">
                        <div class="header-configure-wrapper">
                            <div class="header-configure-area">
                                <ul class="nav justify-content-end">
                                    <li>
                                        <a href="#" class="offcanvas-btn">
                                            <i class="ion-ios-search-strong"></i>
                                        </a>
                                    </li>
                                    <li class="user-hover">
                                        <a href="#">
                                            <i class="ion-ios-gear-outline"></i>
                                        </a>
                                        <ul class="dropdown-list">
                                            @if (User.Identity.IsAuthenticated)
                                            {
                                                <li>
                                                    <a asp-controller="Account" asp-action="Profile">
                                                        @User.Identity.Name
                                                    </a>
                                                </li>
                                                <li>
                                                    <form asp-controller="Account"
                                                          asp-action="Logout"
                                                          method="post"
                                                          style="display:inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" style="background:none;border:none;padding:5px 15px;cursor:pointer;width:100%;text-align:left;">
                                                            Logout
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            else
                                            {
                                                <li><a asp-controller="Account" asp-action="Login">Login</a></li>
                                                <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                                            }
                                        </ul>
                                    </li>
                                    <li>
                                        <a asp-controller="Basket" asp-action="Index" class="minicart-btn">
                                            <i class="ion-bag"></i>
                                            <span class="cart-count" id="cart-count">0</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- mini cart area end -->
                </div>
            </div>
        </div>
        <!-- header middle area end -->
    </div>
    <!-- main header end -->
    
    <!-- mobile header start -->
    <div class="mobile-header d-lg-none d-md-block sticky">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12">
                    <div class="mobile-main-header">
                        <div class="mobile-logo">
                            <a asp-controller="Home" asp-action="Index">
                                <img src="~/assets/img/logo/logo.png" alt="Brand Logo"/>
                            </a>
                        </div>
                        <div class="mobile-menu-toggler">
                            <div class="mini-cart-wrap">
                                <a asp-controller="Basket" asp-action="Index" class="minicart-btn">
                                    <i class="ion-bag"></i>
                                    <span class="cart-count">0</span>
                                </a>
                            </div>
                            <div class="mobile-menu-btn">
                                <div class="off-canvas-btn">
                                    <i class="ion-navicon"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- mobile header end -->
</header>

<!-- Mobile Menu -->
<aside class="off-canvas-wrapper">
    <div class="off-canvas-overlay"></div>
    <div class="off-canvas-inner-content">
        <div class="btn-close-off-canvas">
            <i class="ion-android-close"></i>
        </div>
        <div class="off-canvas-inner">
            <div class="search-box-offcanvas">
                <form>
                    <input type="text" placeholder="Search Here..."/>
                    <button class="search-btn">
                        <i class="ion-ios-search-strong"></i>
                    </button>
                </form>
            </div>
            <div class="mobile-navigation">
                <nav>
                    <ul class="mobile-menu">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Shop" asp-action="Index">Shop</a></li>
                        <li><a asp-controller="Basket" asp-action="Index">Cart</a></li>
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</aside>

<div>
    @RenderBody()
</div>

<!-- Start Footer Area -->
<footer class="footer-wrapper">
    <div class="footer-widget-area section-padding">
        <div class="container">
            <div class="row mtn-40">
                <div class="col-xl-5 col-lg-3 col-md-6">
                    <div class="widget-item mt-40">
                        <h5 class="widget-title">Contact Info</h5>
                        <div class="widget-body">
                            <ul class="location-wrap">
                                <li>
                                    <i class="ion-ios-location-outline"></i>@settings["Address"]
                                </li>
                                <li>
                                    <i class="ion-ios-email-outline"></i>Mail Us:
                                    <a href="mailto:@settings["ContactEmail"]">@settings["ContactEmail"]</a>
                                </li>
                                <li>
                                    <i class="ion-ios-telephone-outline"></i>Phone:
                                    <a href="tel:@settings["ContactPhone"]">@settings["ContactPhone"]</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-6">
                    <div class="widget-item mt-40">
                        <h5 class="widget-title">Quick Links</h5>
                        <div class="widget-body">
                            <ul class="useful-link">
                                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li><a asp-controller="Shop" asp-action="Index">Shop</a></li>
                                <li><a asp-controller="Basket" asp-action="Index">Cart</a></li>
                                <li><a href="#">About Us</a></li>
                                <li><a href="#">Contact</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container">
            <div class="row">
                <div class="col-md-6 order-2 order-md-1">
                    <div class="copyright-text text-center text-md-left">
                        <p>Copyright 2024. All Rights Reserved</p>
                    </div>
                </div>
                <div class="col-md-6 order-1 order-md-2">
                    <div class="footer-social-link text-center text-md-right">
                        <a href="@settings["FacebookUrl"]"><i class="fa fa-facebook"></i></a>
                        <a href="@settings["TwitterUrl"]"><i class="fa fa-twitter"></i></a>
                        <a href="@settings["LinkedInUrl"]"><i class="fa fa-linkedin"></i></a>
                        <a href="@settings["InstagramUrl"]"><i class="fa fa-instagram"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>

<!-- Scroll to top -->
<div class="scroll-top not-visible">
    <i class="fa fa-angle-up"></i>
</div>

<!-- Scripts -->
<script src="~/assets/js/vendor.js"></script>
<script src="~/assets/js/plugins.js"></script>
<script src="~/assets/js/active.js"></script>
<script src="~/assets/js/main.js"></script>

<!-- Toastr JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<!-- Global Cart Script -->
<script>
    // Toastr configuration
    if (typeof toastr !== 'undefined') {
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };
    }

    // Update cart count in header
    function updateCartCount(count) {
        $('.cart-count, #cart-count').text(count);
    }

    // Load cart count on page load
    function loadCartCount() {
        @if (User.Identity.IsAuthenticated)
        {
            @:$.ajax({
            @:    url: '@Url.Action("GetItemCount", "Basket")',
            @:    type: 'GET',
            @:    success: function(response) {
            @:        if (response.itemCount !== undefined) {
            @:            updateCartCount(response.itemCount);
            @:        }
            @:    },
            @:    error: function(xhr, status, error) {
            @:        console.error('Failed to load cart count:', error);
            @:    }
            @:});
        }
    }

    $(document).ready(function() {
        loadCartCount();
    });
</script>

@RenderSection("Scripts", required: false)
</body>
</html>