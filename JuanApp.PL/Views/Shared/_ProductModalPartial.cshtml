@model Product

<div class="product-details-inner">
    <div class="row">
        <!-- Images -->
        <div class="col-lg-5">
            <div class="product-large-slider mb-20">
                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                @foreach (var img in Model.ProductImages)
                {
                <div class="pro-large-img img-zoom">
                    <img src="~/assets/img/product/@img.ImageUrl" alt="product thumb"/>
                </div>
                }
                }
                else
                {
                <div class="pro-large-img">
                    <img src="~/assets/img/product/@Model.ImageUrl" alt="@Model.Name"/>
                </div>
                }
            </div>
            <div class="pro-nav slick-row-5">
                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                @foreach (var img in Model.ProductImages)
                {
                <div class="pro-nav-thumb">
                    <img src="~/assets/img/product/@img.ImageUrl" alt=""/>
                </div>
                }
                }
            </div>
        </div>

        <!-- Details -->
        <div class="col-lg-7">
            <div class="product-details-des">
                <h3 class="pro-det-title">@Model.Name</h3>
                <div class="price-box">
                    @if (Model.DiscountPercentage > 0)
                    {
                    var priceAfterDiscount = Model.Price - (Model.Price * Model.DiscountPercentage / 100);
                    <span class="regular-price">$@priceAfterDiscount.ToString("F2")</span>
                    <span class="old-price"><del>$@Model.Price.ToString("F2")</del></span>
                    }
                    else
                    {
                    <span class="regular-price">$@Model.Price.ToString("F2")</span>
                    }
                </div>
                <p>@Model.Description</p>

                <!-- Color Selection -->
                @if (Model.Colors != null && Model.Colors.Any())
                {
                <div class="color-list-wrapper mb-20">
                    <h5 class="cat-title">Color:</h5>
                    <select id="quickview-color-@Model.Id" class="form-control" style="width: 200px;">
                        <option value="">Choose color</option>
                        @foreach (var color in Model.Colors)
                        {
                        <option value="@color.Id">@color.Name</option>
                        }
                    </select>
                </div>
                }

                <!-- Size Selection -->
                @if (Model.Sizes != null && Model.Sizes.Any())
                {
                <div class="size-list-wrapper mb-20">
                    <h5 class="cat-title">Size:</h5>
                    <select id="quickview-size-@Model.Id" class="form-control" style="width: 200px;">
                        <option value="">Choose size</option>
                        @foreach (var size in Model.Sizes)
                        {
                        <option value="@size.Id">@size.SizeType</option>
                        }
                    </select>
                </div>
                }

                <!-- Quantity + Add to Cart -->
                <div class="quantity-cart-box d-flex align-items-center mb-20">
                    <div class="quantity">
                        <div class="pro-qty" id="pro-qty-@Model.Id">
                            <input type="text" value="1" id="quickview-qty-@Model.Id" />
                        </div>
                    </div>
                    <button type="button"
                            onclick="handleQuickViewAddToCart(@Model.Id, @((Model.Colors != null && Model.Colors.Any()).ToString().ToLower()), @((Model.Sizes != null && Model.Sizes.Any()).ToString().ToLower()))"
                            class="btn btn-default"
                            id="quickview-btn-@Model.Id">
                        Add To Cart
                    </button>
                </div>

                <!-- Availability -->
                <div class="availability mb-20">
                    <h5 class="cat-title">Availability:</h5>
                    @if (Model.InStock)
                    {
                    <span class="text-success">In Stock</span>
                    }
                    else
                    {
                    <span class="text-danger">Out of Stock</span>
                    }
                </div>

                <!-- Share Icons -->
                <div class="share-icon">
                    <h5 class="cat-title">Share:</h5>
                    <a href="#"><i class="fa fa-facebook"></i></a>
                    <a href="#"><i class="fa fa-twitter"></i></a>
                    <a href="#"><i class="fa fa-pinterest"></i></a>
                    <a href="#"><i class="fa fa-google-plus"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Initialize quantity buttons
    (function() {
        var $proQty = $('#pro-qty-@Model.Id');
        var $input = $('#quickview-qty-@Model.Id');
        
        // Remove existing buttons
        $proQty.find('.qtybtn').remove();
        
        // Add new buttons
        $proQty.prepend('<span class="dec qtybtn">-</span>');
        $proQty.append('<span class="inc qtybtn">+</span>');
        
        // Button click handlers
        $proQty.find('.qtybtn').on('click', function() {
            var $button = $(this);
            var oldValue = parseFloat($input.val());
            var newVal;
            
            if ($button.hasClass('inc')) {
                newVal = oldValue + 1;
            } else {
                newVal = oldValue > 1 ? oldValue - 1 : 1;
            }
            $input.val(newVal);
        });
    })();

    // Handle Add to Cart from Quick View
    function handleQuickViewAddToCart(productId, hasColors, hasSizes) {
        var quantity = parseInt($('#quickview-qty-' + productId).val()) || 1;
        var colorId = $('#quickview-color-' + productId).val();
        var sizeId = $('#quickview-size-' + productId).val();

        // Validation
        if (hasColors && !colorId) {
            toastr.warning('Please select a color');
            return;
        }

        if (hasSizes && !sizeId) {
            toastr.warning('Please select a size');
            return;
        }

        // Show loading
        var btn = $('#quickview-btn-' + productId);
        var originalText = btn.html();
        btn.html('<i class="fa fa-spinner fa-spin"></i> Adding...');
        btn.prop('disabled', true);

        // Call AJAX
        $.ajax({
            url: '@Url.Action("AddToCart", "Basket")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                productId: productId,
                quantity: quantity,
                colorId: colorId || null,
                sizeId: sizeId || null
            }),
            success: function(response) {
                btn.html(originalText);
                btn.prop('disabled', false);

                if (response.success) {
                    toastr.success('Product added to cart successfully!');
                    
                    // Update cart count
                    if (typeof updateCartCount === 'function') {
                        updateCartCount(response.itemCount);
                    }
                    
                    // Close modal after short delay
                    setTimeout(function() {
                        $('#quick_view').modal('hide');
                    }, 800);
                } else {
                    toastr.error(response.message || 'Failed to add product');
                }
            },
            error: function(xhr, status, error) {
                btn.html(originalText);
                btn.prop('disabled', false);
                console.error('Error:', error);
                toastr.error('An error occurred. Please try again.');
            }
        });
    }
</script>