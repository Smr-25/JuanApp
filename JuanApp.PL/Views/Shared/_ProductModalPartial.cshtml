@model Product

<div class="product-details-inner">
    <div class="row">
        <!-- Images -->
        <div class="col-lg-5">
            <div class="product-large-slider-modal mb-20" id="modal-large-slider-@Model.Id">
                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    @foreach (var img in Model.ProductImages)
                    {
                        <div class="pro-large-img img-zoom">
                            <img src="/@img.ImageUrl" alt="@Model.Name"/>
                        </div>
                    }
                }
                else
                {
                    <div class="pro-large-img">
                        <img src="/@Model.ImageUrl" alt="@Model.Name"/>
                    </div>
                }
            </div>
            <div class="pro-nav-modal slick-row-5" id="modal-nav-slider-@Model.Id">
                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    @foreach (var img in Model.ProductImages)
                    {
                        <div class="pro-nav-thumb">
                            <img src="/@img.ImageUrl" alt=""/>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Details -->
        <div class="col-lg-7">
            <div class="product-details-des">
                <h3 class="pro-det-title">@Model.Name</h3>
                <div class="price-box">
                    @if (Model.DiscountPercentage > 0)
                    {
                        var priceAfterDiscount = Model.Price - (Model.Price * Model.DiscountPercentage / 100);
                        <span class="regular-price">₼@priceAfterDiscount.ToString("F2")</span>
                        <span class="old-price"><del>₼@Model.Price.ToString("F2")</del></span>
                    }
                    else
                    {
                        <span class="regular-price">₼@Model.Price.ToString("F2")</span>
                    }
                </div>
                <p class="mb-20">@Model.Description</p>

                <!-- Color Selection -->
                @if (Model.Colors != null && Model.Colors.Any())
                {
                    <div class="color-list-wrapper mb-20">
                        <h5 class="cat-title">Color:</h5>
                        <div class="color-selection-wrapper" style="display: flex; gap: 10px; flex-wrap: wrap;">
                            @foreach (var color in Model.Colors)
                            {
                                <label class="color-selection-item-@Model.Id" style="cursor: pointer; position: relative;">
                                    <input type="radio" name="quickview-color-@Model.Id" value="@color.Id" class="color-radio-@Model.Id" style="position: absolute; opacity: 0;" />
                                    <div class="color-box-@Model.Id" style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 2px solid #ddd; border-radius: 6px; transition: all 0.3s;">
                                        <span class="color-preview" style="width: 25px; height: 25px; background-color: @color.HexCode; border: 1px solid #ccc; border-radius: 4px; display: inline-block;"></span>
                                        <span class="color-name" style="font-size: 14px; font-weight: 500;">@color.Name</span>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                }

                <!-- Size Selection -->
                @if (Model.Sizes != null && Model.Sizes.Any())
                {
                    <div class="size-list-wrapper mb-20">
                        <h5 class="cat-title">Size:</h5>
                        <div class="size-selection-wrapper" style="display: flex; gap: 10px; flex-wrap: wrap;">
                            @foreach (var size in Model.Sizes)
                            {
                                <label class="size-selection-item-@Model.Id" style="cursor: pointer;">
                                    <input type="radio" name="quickview-size-@Model.Id" value="@size.Id" class="size-radio-@Model.Id" style="position: absolute; opacity: 0;" />
                                    <div class="size-box-@Model.Id" style="min-width: 50px; padding: 10px 16px; border: 2px solid #ddd; border-radius: 6px; text-align: center; font-weight: 600; transition: all 0.3s;">
                                        @size.Name
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                }

                <!-- Quantity + Add to Cart -->
                <div class="quantity-cart-box d-flex align-items-center mb-20">
                    <div class="quantity">
                        <div class="pro-qty" id="pro-qty-@Model.Id">
                            <input type="text" value="1" id="quickview-qty-@Model.Id" />
                        </div>
                    </div>
                    <button type="button"
                            onclick="handleQuickViewAddToCart(event, @Model.Id)"
                            class="btn btn-default"
                            id="quickview-btn-@Model.Id">
                        Add To Cart
                    </button>
                </div>

                <!-- Availability -->
                <div class="availability mb-20">
                    <h5 class="cat-title">Availability:</h5>
                    @if (Model.InStock)
                    {
                        <span class="text-success"><i class="fa fa-check"></i> In Stock</span>
                    }
                    else
                    {
                        <span class="text-danger"><i class="fa fa-times"></i> Out of Stock</span>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        // Sliders
        setTimeout(function() {
            var largeSlider = $('#modal-large-slider-@Model.Id');
            var navSlider = $('#modal-nav-slider-@Model.Id');
            
            if (largeSlider.length && !largeSlider.hasClass('slick-initialized')) {
                largeSlider.slick({ slidesToShow: 1, slidesToScroll: 1, arrows: false, fade: true, asNavFor: '#modal-nav-slider-@Model.Id' });
            }
            
            if (navSlider.length && !navSlider.hasClass('slick-initialized')) {
                navSlider.slick({ slidesToShow: 4, slidesToScroll: 1, asNavFor: '#modal-large-slider-@Model.Id', dots: false, arrows: true, focusOnSelect: true });
            }
        }, 300);

        // Quantity buttons
        var $proQty = $('#pro-qty-@Model.Id');
        var $input = $('#quickview-qty-@Model.Id');
        
        $proQty.find('.qtybtn').remove();
        $proQty.prepend('<span class="dec qtybtn">-</span>');
        $proQty.append('<span class="inc qtybtn">+</span>');
        
        $proQty.find('.qtybtn').on('click', function() {
            var $button = $(this);
            var oldValue = parseInt($input.val());
            var newVal = $button.hasClass('inc') ? oldValue + 1 : (oldValue > 1 ? oldValue - 1 : 1);
            $input.val(newVal);
        });

        // Color selection styling
        $('.color-radio-@Model.Id').on('change', function() {
            $('.color-box-@Model.Id').css({'border-color': '#ddd', 'background': 'transparent'});
            $(this).siblings('.color-box-@Model.Id').css({'border-color': '#333', 'background': '#f8f8f8'});
        });

        // Size selection styling
        $('.size-radio-@Model.Id').on('change', function() {
            $('.size-box-@Model.Id').css({'border-color': '#ddd', 'background': 'white', 'color': '#333'});
            $(this).siblings('.size-box-@Model.Id').css({'border-color': '#333', 'background': '#333', 'color': 'white'});
        });
    });

    function handleQuickViewAddToCart(event, productId) {
        if(event) event.preventDefault();

        var quantity = parseInt($('#quickview-qty-' + productId).val()) || 1;
        var color = $('input[name="quickview-color-' + productId + '"]:checked').val() || null;
        var size = $('input[name="quickview-size-' + productId + '"]:checked').val() || null;

        var data = { ProductId: productId, Quantity: quantity, ColorId: color, SizeId: size };

        var btn = $('#quickview-btn-' + productId);
        var originalText = btn.html();
        btn.html('<i class="fa fa-spinner fa-spin"></i> Adding...').prop('disabled', true);

        $.ajax({
            url: '/Basket/AddToBasket',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function(response) {
                btn.html(originalText).prop('disabled', false);

                if (response.success) {
                    toastr.success('Product added to cart!');
                    if (typeof updateCartCount === 'function') {
                        updateCartCount(response.itemCount);
                    }
                    setTimeout(function() { $('#quick_view').modal('hide'); }, 800);
                } else {
                    toastr.error(response.message || 'Failed to add product');
                }
            },
            error: function() {
                btn.html(originalText).prop('disabled', false);
                toastr.error('An error occurred. Please try again.');
            }
        });
    }
</script>
